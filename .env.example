# ── WhatsApp Cloud API (required for production) ──────────────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Webhook verification token — must match what you set in the Meta dashboard
VERIFY_TOKEN=ogaai_verify_2024

# ── Cowrie Airtime API (required for live airtime/data top-ups) ───────────────
# Sign up at https://cowriesys.com
COWRIE_CLIENT_ID=
COWRIE_CLIENT_KEY=

# ── LLM (for UNKNOWN intents and conversational replies) ─────────────────────
# Claude (primary) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# GPT-4o-mini (fallback) — https://platform.openai.com
OPENAI_API_KEY=

# ── Optional: logging level ───────────────────────────────────────────────────
LOG_LEVEL=INFO
