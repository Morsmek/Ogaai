# ── WhatsApp Cloud API (required for production) ──────────────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Webhook verification token — must match what you set in the Meta dashboard
VERIFY_TOKEN=ogaai_verify_2024

# ── Cowrie Airtime API (required for live airtime/data top-ups) ───────────────
# Sign up at https://cowriesys.com
COWRIE_CLIENT_ID=
COWRIE_CLIENT_KEY=

# ── LLM (conversational replies + unknown intents) ───────────────────────────
# Priority: free tiers first, paid last. Only ONE key is needed.
# On Cloudflare Pages, Workers AI (Llama 3.1 8B) runs free before all of these.
#
# ── FREE TIER ─────────────────────────────────────────────────────────────────
# Groq         — Llama 3.1 8B, very fast  — https://console.groq.com
GROQ_API_KEY=

# Google Gemini — gemini-2.0-flash-lite   — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter   — many free models         — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras     — Llama 3.1 8B, ultra-fast — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── PAID ──────────────────────────────────────────────────────────────────────
# DeepSeek — cheap, OpenAI-compatible     — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic Claude Haiku                  — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI GPT-4o-mini                      — https://platform.openai.com
OPENAI_API_KEY=

# ── Optional: logging level ───────────────────────────────────────────────────
LOG_LEVEL=INFO
